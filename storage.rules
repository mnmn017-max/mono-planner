rules_version = '2';
// MONO PLANNER - Firebase Storage 보안 규칙
// 채팅에서 10MB를 넘는 첨부파일(최대 100MB)만 여기에 저장된다. (10MB 이하는 Cloudinary)
// 경로: chatFiles/{채팅방ID}/{시각_파일명}
// - 채팅방 참여 여부는 메시지를 남길 때 Firestore 규칙이 확인한다.
// - 파일 링크에는 추측할 수 없는 토큰이 붙어 있어 링크를 받은 사람만 열 수 있다.
service firebase.storage {
  match /b/{bucket}/o {
    match /chatFiles/{roomId}/{fileName} {
      // 받기: 로그인한 사용자
      allow read: if request.auth != null;
      // 올리기: 로그인한 사용자, 100MB 미만, 새 파일만(덮어쓰기 금지)
      allow create: if request.auth != null
                    && request.resource.size < 100 * 1024 * 1024
                    && resource == null;
      // 수정·삭제는 서버(30일 자동 정리)만
      allow update, delete: if false;
    }

    // 그 밖의 경로는 모두 막음
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
